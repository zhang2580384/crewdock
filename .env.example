# Generate a private .env with: python3 scripts/init-env.py
CREWDOCK_ROOT=/opt/crewdock
CREWDOCK_HOST=0.0.0.0
CREWDOCK_PORT=16888
CREWDOCK_WEB_BIND=127.0.0.1
CREWDOCK_WEB_PORT=16888
CREWDOCK_PUBLIC_BASE_URL=http://127.0.0.1:16888
# Check host routes and existing Docker networks before choosing a subnet.
CREWDOCK_NETWORK_NAME=crewdock
CREWDOCK_NETWORK_SUBNET=172.16.241.0/24
CREWDOCK_TRUSTED_PROXY_TOKEN=
CREWDOCK_ICON_PRIVATE_ORIGINS=
CREWDOCK_DATABASE_URL=postgres://crewdock:REPLACE_WITH_RANDOM_HEX@127.0.0.1:5432/crewdock
CREWDOCK_REDIS_URL=redis://127.0.0.1:6379/0
CREWDOCK_FILE_ROOT=./deploy/files
# Required: base64 encoding of 32 random bytes. Keep this key with your backups.
CREWDOCK_MASTER_KEY=
CREWDOCK_SESSION_SECRET=
CREWDOCK_SESSION_TTL_DAYS=90
CREWDOCK_SESSION_REFRESH_HOURS=24
CREWDOCK_LIBREOFFICE_BIN=libreoffice
CREWDOCK_PDFTOPPM_BIN=pdftoppm
CREWDOCK_BOOTSTRAP_EMAIL=admin@example.com
CREWDOCK_BOOTSTRAP_PASSWORD=
CREWDOCK_BOOTSTRAP_NAME=System Admin
POSTGRES_DB=crewdock
POSTGRES_USER=crewdock
POSTGRES_PASSWORD=
CREWDOCK_VERSION=0.10.1
CREWDOCK_GIT_SHA=unknown
CREWDOCK_BUILD_TIME=unknown
CREWDOCK_DEBIAN_MIRROR=http://deb.debian.org/debian
CREWDOCK_DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
